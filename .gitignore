/target
# Owned game data and per-user state must never be committed.
/library/
/state/
/fmv-state/
*.lgp
*.LGP
*.bin.orig
*.cue
*.iso
*.chd
*.ff7
*.mcr
/.claude/settings.local.json
# Infrastructure notes with tailnet/host identifiers stay local (not pushed to GitHub).
/PROJECT-BRIEF.md
/PROJECT-METADATA.json
/DEPLOYMENT-CONTRACT.md

# import/library state anywhere in the tree
library/
import-sessions/
/u.cli.*
/.claude/
# Release packaging output (scripts/package.sh). Built archives are never committed.
/dist/
# Local deployment env files can hold real host/port values; only placeholder templates are committed.
/deploy/*.env
__pycache__/
